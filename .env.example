# ---------------------------------------------------------------------------
# trck environment configuration
#
# Copy to `.env.local` for local development. NEVER commit real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle — the
# Supabase service-role key must never appear here.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project URL and the *anon* (publishable) key. The anon key is safe in the
# browser precisely because every table is protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Object storage adapter ------------------------------------------------
# supabase | r2
# `supabase` uses private Supabase Storage buckets (zero extra setup).
# `r2` uses Cloudflare R2 through a signing Edge Function (no S3 credentials
# ever reach the browser). See docs/ARCHITECTURE.md ("Storage adapter").
VITE_STORAGE_PROVIDER=supabase
# Bucket / R2 bucket names. Both MUST be private.
VITE_STORAGE_BUCKET_FACES=employee-faces
VITE_STORAGE_BUCKET_DASHBOARDS=dashboard-captures

# --- Face recognition adapter ---------------------------------------------
# human | mock
# `mock` is deterministic and model-free — used by tests, CI and E2E runs.
VITE_FACE_PROVIDER=human
# Where the Human model weights are served from. Defaults to the package's
# own CDN path; self-host these files for offline/air-gapped deployments.
VITE_FACE_MODEL_BASE_PATH=https://cdn.jsdelivr.net/npm/@vladmandic/human-models@3.3.5/models/

# --- OCR adapter -----------------------------------------------------------
# tesseract | mock
VITE_OCR_PROVIDER=tesseract
# Optional self-hosted Tesseract worker/core/lang paths (leave blank for CDN).
VITE_OCR_WORKER_PATH=
VITE_OCR_CORE_PATH=
VITE_OCR_LANG_PATH=

# --- Analytics adapter -----------------------------------------------------
# supabase | console | noop
VITE_ANALYTICS_PROVIDER=supabase

# --- Behaviour flags -------------------------------------------------------
VITE_APP_ENV=development
VITE_ENABLE_PWA=true
# Set to 'true' only in demo deployments; shows seeded demo credentials on the
# login screen.
VITE_SHOW_DEMO_CREDENTIALS=false
# debug | info | warn | error | silent
# Defaults to `debug` in development and `warn` in a production build.
VITE_LOG_LEVEL=

# ---------------------------------------------------------------------------
# Server-side only — set these as Supabase Edge Function secrets, never here.
#   supabase secrets set \
#     ALLOWED_ORIGINS=https://trck.example.com \
#     APP_URL=https://trck.example.com \
#     R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#     R2_REGION=auto R2_BUCKET_FACES=... R2_BUCKET_DASHBOARDS=...
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions by the platform — do not set them yourself, and never
# put the service-role key in any file with a VITE_ prefix.
# ---------------------------------------------------------------------------
